rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      function isAccountOwner() {
        return request.auth != null && request.auth.uid == userId;
      }

      allow read, create, update, delete: if isAccountOwner();

      match /{documentPath=**} {
        allow read, delete: if isAccountOwner();
        allow create, update: if isAccountOwner()
          && request.resource.data.ownerUid == userId;
      }
    }
  }
}
